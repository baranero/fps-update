# Wzorzec konfiguracji — skopiuj do .env.local i uzupełnij wartości.
#
# PLIK GENEROWANY: nie edytuj ręcznie. Źródłem jest lib/env.ts,
# a wzorzec odświeża `npm run env:przyklad`.
#
# Sprawdzenie, czego brakuje na tym wdrożeniu: `npm run preflight`.
# Zmienne z przedrostkiem NEXT_PUBLIC_ trafiają do przeglądarki — reszta NIE
# i nigdy nie wolno ich tak nazwać.

# ────────────────────────────────────────────────────────────────────────
# RDZEŃ (KONTA, BAZA, ADRESY)
# Bez wymaganych zmiennych: Serwis nie wstanie.
# ────────────────────────────────────────────────────────────────────────

# Adres projektu Supabase — konta, profile i zlecenia.
NEXT_PUBLIC_SUPABASE_URL=

# Klucz publiczny Supabase dla przeglądarki (chroniony przez RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz serwerowy z pominięciem RLS — trasy API i panel admina. NIGDY do przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=

# Adres serwisu chmurowego — odnośniki w mailach i powroty z płatności.
# Gdy puste, kod używa: https://fdsrun.com
NEXT_PUBLIC_APP_URL=

# Adres witryny usługowej — odnośniki krzyżowe z chmury.
# Gdy puste, kod używa: https://fp-solutions.pl
# NEXT_PUBLIC_MARKETING_URL=

# Który produkt serwuje TEN projekt Vercel: „cloud” albo „marketing”. Puste = dev (rozpoznanie po ścieżce).
# NEXT_PUBLIC_SITE_MODE=

# ────────────────────────────────────────────────────────────────────────
# POCZTA TRANSAKCYJNA
# Bez wymaganych zmiennych: Klient nie dostanie ani potwierdzenia, ani wyników; prośby o dostęp nie dotrą do właściciela.
# ────────────────────────────────────────────────────────────────────────

# Wysyłka maili transakcyjnych. Bez niej zlecenie przejdzie, ale klient nie dostanie potwierdzenia.
RESEND_API_KEY=

# Konto właściciela: rozpoznanie admina ORAZ adres powiadomień o zleceniach i prośbach o dostęp.
ADMIN_EMAIL=

# Nadawca maili. Zmień dopiero, gdy domena jest zweryfikowana w Resend (SPF/DKIM).
# Gdy puste, kod używa: FP Solutions <noreply@fp-solutions.pl>
# MAIL_FROM=

# ────────────────────────────────────────────────────────────────────────
# OBLICZENIA W CHMURZE
# Bez wymaganych zmiennych: Zlecenia nie ruszą albo zawisną bez raportu z maszyny.
# ────────────────────────────────────────────────────────────────────────

# Zakładanie i kasowanie maszyn liczących.
HETZNER_API_TOKEN=

# Obraz maszyny z gotowym FDS — bez niego każdy bieg instaluje solver od zera.
HETZNER_SNAPSHOT_ID=

# Podpis raportów z maszyny liczącej. Bez niego /complete odrzuca wszystko — zlecenia wiszą w „running”.
WEBHOOK_SECRET=

# Magazyn wyników (S3) — klucz dostępu.
HETZNER_STORAGE_ACCESS_KEY=

# Magazyn wyników (S3) — klucz tajny.
HETZNER_STORAGE_SECRET_KEY=

# Nazwa kubełka z wynikami.
HETZNER_STORAGE_BUCKET=

# Adres magazynu obiektów.
HETZNER_STORAGE_ENDPOINT=

# Region magazynu.
# HETZNER_STORAGE_REGION=

# Preferowana lokalizacja maszyn; bez niej planer wybiera sam wg dostępności.
# HETZNER_LOCATION=

# Zapas: skąd pobrać solver, gdy obraz maszyny go nie ma.
# FDS_DOWNLOAD_URL=

# Stawka magazynu do rachunku marży w panelu admina.
# HETZNER_STORAGE_PRICE_PER_TB_EUR=

# ────────────────────────────────────────────────────────────────────────
# PŁATNOŚCI ONLINE
# Bez wymaganych zmiennych: Klient nie zapłaci w serwisie — zostaje faktura wystawiana ręcznie.
# ────────────────────────────────────────────────────────────────────────

# Tworzenie płatności. Bez niej /checkout oddaje 503 z czytelnym komunikatem.
STRIPE_SECRET_KEY=

# Weryfikacja podpisu Stripe. Bez niej NIE WOLNO ufać zdarzeniom — webhook je odrzuca.
STRIPE_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────────────────
# UTRZYMANIE (CRON)
# Bez wymaganych zmiennych: Stare wyniki zostaną w magazynie, a zawieszone zlecenia nikt nie zamknie.
# ────────────────────────────────────────────────────────────────────────

# Autoryzacja crona sprzątającego: kasowanie starych wyników i ratowanie zawieszonych zleceń.
CRON_SECRET=
